{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "*.{css,js,png,gif,ico,jpg,jpeg,svg,webp,json}"
    ]
  },
  "globalHeaders": {
    "Cache-Control": "max-age=3600",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  }
}
  
